# Скопируйте этот файл как .env и замените секретный ключ.
APP_UID=1000
APP_GID=1000

DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=0

# Локальный IP нужен для первичной проверки, домен — для Nginx и HTTPS.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.1.4.137,npa-api.geology-ecatalog.net.kg
DJANGO_CSRF_TRUSTED_ORIGINS=http://10.1.4.137:8001,https://npa-api.geology-ecatalog.net.kg

# Постоянные каталоги внутри контейнера.
DJANGO_DB_PATH=/app/data/db.sqlite3
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_MEDIA_ROOT=/app/media

# Включить обе настройки после выпуска HTTPS-сертификата.
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_SSL_REDIRECT=0

# Необязательно: только имя хоста без https:// и /api.
NGROK_HOST=

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
